# Nothing here is required. The app runs with no keys.
PORT=5000
# Enables POST /api/weekly/run for a scheduler (send it as header X-Token). Empty = the endpoint is disabled (403).
WEEKLY_TOKEN=
# 1 = stamp new questions with real time; default pins the demo clock to the end of the reviews export
REAL_CLOCK=0
# Optional LLM rephrasing (untested). The reviewer checks any LLM draft like a template draft.
GROQ_API_KEY=
USE_LLM=1
GROQ_MODEL=llama-3.3-70b-versatile

# Access control. If REVIEWER_PASSWORD is set, only a logged-in reviewer can edit/approve/reject/re-draft/run weekly.
REVIEWER_PASSWORD=
SECRET_KEY=
COOKIE_SECURE=
# Number of trusted reverse proxies in front of the app (1 on Render). 0 = use the direct peer address.
PROXY_HOPS=0
